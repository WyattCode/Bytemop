{
  "pack": "browsers",
  "version": "1.0.0",
  "rules": [
    {
      "id": "chrome-cache",
      "name": {
        "zh-CN": "Google Chrome 缓存",
        "en": "Google Chrome cache"
      },
      "description": {
        "zh-CN": "网页资源缓存，删除后会按需重新下载，不会清除登录状态与书签。",
        "en": "Cached web resources, re-downloaded on demand. Logins and bookmarks are not affected."
      },
      "category": "browser",
      "risk": "safe",
      "defaultSelected": true,
      "requiresAdmin": false,
      "blockedByProcesses": [
        "chrome.exe"
      ],
      "action": "files",
      "targets": [
        {
          "path": "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\*\\Cache",
          "recurse": true
        },
        {
          "path": "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\*\\Code Cache",
          "recurse": true
        },
        {
          "path": "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\*\\GPUCache",
          "recurse": true
        }
      ],
      "since": "1.0.0"
    },
